# Copy to .env and fill in your Google OAuth credentials.
# Get them from: https://console.cloud.google.com/apis/credentials
#
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Authorized redirect URI (must match exactly):
#    http://127.0.0.1:8000/accounts/google/login/callback/
# 3. Run: python manage.py setup_google_oauth
# 4. Open the app at http://127.0.0.1:8000/ (not localhost)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — override the callback URL (default shown above)
# GOOGLE_OAUTH_CALLBACK_URI=http://127.0.0.1:8000/accounts/google/login/callback/

# Render API key (Account Settings → API Keys). Used by CLI/scripts — never commit.
# RENDER_API_KEY=rnd_xxxxxxxx

# --- Render production ---
# Render auto-sets RENDER_EXTERNAL_HOSTNAME and RENDER_EXTERNAL_URL; settings.py picks those up.
# Still set these in Render Dashboard → Environment for explicit production config:
# DEBUG=False
# SECRET_KEY=generate-a-long-random-string
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# Optional overrides:
# ALLOWED_HOSTS=budgetme-t44m.onrender.com
# CSRF_TRUSTED_ORIGINS=https://budgetme-t44m.onrender.com
# GOOGLE_OAUTH_CALLBACK_URI=https://budgetme-t44m.onrender.com/accounts/google/login/callback/
